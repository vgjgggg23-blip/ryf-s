# انسخ هذا الملف باسم .env واملأ القيم

PORT=3000
# رابط موقعك الحقيقي بدون شرطة في النهاية (مثال: https://your-domain.com)
SITE_URL=http://localhost:3000
# نص عشوائي طويل لتأمين الجلسات
SESSION_SECRET=change-this-to-a-long-random-text

# من Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# رقم سيرفر المتجر
DISCORD_GUILD_ID=

# أرقام حسابات الديسكورد المسموح لها بدخول لوحة التحكم (افصل بينها بفاصلة)
ADMIN_IDS=

# مكان حفظ البيانات والصور المرفوعة
DATA_DIR=./data

# رابط قاعدة MongoDB (مثل Atlas المجاني) للحفظ الدائم. مطلوب على Render المجاني
# وإلا تُمسح التعديلات والصور عند كل إعادة تشغيل. مثال:
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
